    "test:admin-assists": "node --no-warnings --experimental-strip-types scripts/admin-assists-check.mjs",
    "test:match-details": "node --no-warnings --experimental-strip-types scripts/match-details-check.mjs",
    "test:github-auth": "node --no-warnings --experimental-strip-types scripts/github-sync-auth-check.mjs",
    "test:automation": "node --no-warnings --experimental-strip-types scripts/automation-check.mjs",
    "test:data-health": "node --no-warnings --experimental-strip-types scripts/data-health-check.mjs",
    "test:super-lig-sync": "node --no-warnings --experimental-strip-types scripts/super-lig-sync-check.mjs",
