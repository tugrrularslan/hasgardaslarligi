rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    function validPrediction(value) {
      return value == "1" || value == "X" || value == "2";
    }

    function predictionIsOpen(matchId) {
      return matchExists(matchId)
        && get(/databases/$(database)/documents/matches/$(matchId)).data.status == "scheduled"
        && request.time < get(/databases/$(database)/documents/matches/$(matchId)).data.predictionDeadline;
    }

    function kahinPredictionIsOpen() {
      return exists(/databases/$(database)/documents/settings/kahin)
        && get(/databases/$(database)/documents/settings/kahin).data.get("resultsPublished", false) != true
        && get(/databases/$(database)/documents/settings/kahin).data.get("deadline", null) is timestamp
        && request.time < get(/databases/$(database)/documents/settings/kahin).data.deadline;
    }

    function validOwnerKahinPredictionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "kahinSeasonId",
          "kahinPrediction",
          "kahinUpdatedAt"
        ])
        && kahinPredictionIsOpen()
        && request.resource.data.get("kahinSeasonId", "") == get(/databases/$(database)/documents/settings/kahin).data.seasonId
        && request.resource.data.get("kahinPrediction", null) is map;
    }

    function kahinTransferReplacementIsOpen() {
      return exists(/databases/$(database)/documents/settings/kahin)
        && get(/databases/$(database)/documents/settings/kahin).data.get("resultsPublished", false) != true
        && get(/databases/$(database)/documents/settings/kahin).data.get("deadline", null) is timestamp
        && request.time >= get(/databases/$(database)/documents/settings/kahin).data.deadline;
    }

    function validKahinTransferReplacement(category) {
      let currentReopens = resource.data.get("kahinTransferReopens", {});
      let requestedReopens = request.resource.data.get("kahinTransferReopens", {});
      let currentReopen = currentReopens.get(category, {});
      let requestedReopen = requestedReopens.get(category, {});
      let currentPrediction = resource.data.get("kahinPrediction", {});
      let requestedPrediction = request.resource.data.get("kahinPrediction", {});
      return currentReopens is map
        && requestedReopens is map
        && currentReopen is map
        && requestedReopen is map
        && currentPrediction is map
        && requestedPrediction is map
        && requestedReopens.diff(currentReopens).affectedKeys().hasOnly([category])
        && requestedPrediction.diff(currentPrediction).affectedKeys().hasOnly([category])
        && currentReopen.get("category", "") == category
        && currentReopen.get("originalSelection", "") == currentPrediction.get(category, "")
        && currentReopen.get("replacementSelection", "") == ""
        && currentReopen.get("replacementDeadline", null) is timestamp
        && request.time < currentReopen.get("replacementDeadline", null)
        && requestedReopen.diff(currentReopen).affectedKeys().hasOnly([
          "replacementSelection",
          "replacementSelectedAt"
        ])
        && requestedReopen.get("replacementSelection", "") is string
        && requestedReopen.get("replacementSelection", "") != ""
        && requestedReopen.get("replacementSelection", "") != currentReopen.get("originalSelection", "")
        && requestedReopen.get("replacementSelection", "") == requestedPrediction.get(category, "")
        && requestedReopen.get("replacementSelectedAt", null) == request.time;
    }

    function validOwnerKahinTransferReplacement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "kahinPrediction",
          "kahinTransferReopens",
          "kahinUpdatedAt"
        ])
        && kahinTransferReplacementIsOpen()
        && request.resource.data.get("kahinSeasonId", "") == resource.data.get("kahinSeasonId", "")
        && request.resource.data.get("kahinSeasonId", "") == get(/databases/$(database)/documents/settings/kahin).data.seasonId
        && (
          validKahinTransferReplacement("topScorer")
          || validKahinTransferReplacement("topAssist")
          || validKahinTransferReplacement("cleanSheetKeeper")
        );
    }

    function usernameChanged() {
      return request.resource.data.username != resource.data.username;
    }

    function validUsername() {
      return request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 20;
    }

    function validOneTimeUsernameChange() {
      return usernameChanged()
        && resource.data.get("usernameChanged", false) == false
        && request.resource.data.usernameChanged == true
        && validUsername();
    }

    function usernameFieldsUnchanged() {
      return request.resource.data.username == resource.data.username
        && request.resource.data.get("usernameLower", "") == resource.data.get("usernameLower", "")
        && request.resource.data.get("usernameChanged", false) == resource.data.get("usernameChanged", false)
        && request.resource.data.get("usernameChangedAt", null) == resource.data.get("usernameChangedAt", null);
    }

    function validOwnerProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username",
          "usernameLower",
          "usernameChanged",
          "usernameChangedAt",
          "avatar",
          "selectedTheme",
          "updatedAt"
        ])
        && request.resource.data.get("isAdmin", false) == resource.data.get("isAdmin", false)
        && (usernameFieldsUnchanged() || validOneTimeUsernameChange());
    }

    function validBadgeId(value) {
      return value == "devrik-lider"
        || value == "gonullerin-sampiyonu"
        || value == "ilk-kan"
        || value == "hat-trick"
        || value == "besibirlik"
        || value == "gobel-ne-biliyo-la"
        || value == "yaniyo"
        || value == "makine"
        || value == "esas-gobel"
        || value == "ilk-zafer"
        || value == "seri-sampiyon"
        || value == "hafta-canavari"
        || value == "sadik-gardas"
        || value == "sezon-emektari";
    }

    function validOwnerBadgePreferenceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "selectedBadges",
          "activeTitle",
          "badgesUpdatedAt",
          "updatedAt"
        ])
        && request.resource.data.get("selectedBadges", []) is list
        && request.resource.data.get("selectedBadges", []).size() <= 3
        && request.resource.data.get("selectedBadges", []).toSet().hasOnly([
          "devrik-lider",
          "gonullerin-sampiyonu",
          "ilk-kan",
          "hat-trick",
          "besibirlik",
          "gobel-ne-biliyo-la",
          "yaniyo",
          "makine",
          "esas-gobel",
          "ilk-zafer",
          "seri-sampiyon",
          "hafta-canavari",
          "sadik-gardas",
          "sezon-emektari"
        ])
        && request.resource.data.get("activeTitle", "") is string
        && (
          request.resource.data.get("activeTitle", "") == ""
          || validBadgeId(request.resource.data.get("activeTitle", ""))
        );
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.get("isAdmin", false) == false;
      allow update: if isAdmin()
        || (isOwner(userId) && (
          validOwnerProfileUpdate()
          || validOwnerBadgePreferenceUpdate()
          || validOwnerKahinPredictionUpdate()
          || validOwnerKahinTransferReplacement()
        ));
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && predictionId == request.auth.uid + "_" + request.resource.data.matchId
        && validPrediction(request.resource.data.prediction)
        && predictionIsOpen(request.resource.data.matchId);

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.matchId == resource.data.matchId
          && validPrediction(request.resource.data.prediction)
          && predictionIsOpen(resource.data.matchId)
        );

      allow delete: if isAdmin();
    }

    match /notificationTokens/{tokenId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.enabled == true;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == resource.data.token;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notificationRequests/{requestId} {
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.targetUrl is string
        && request.resource.data.targetUrl.matches('^/.*')
        && request.resource.data.audience == "all"
        && request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    match /publishedWeeks/{weekId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /weeklyChampions/{weekId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /automaticNotificationEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /kahinTransferOperations/{operationId} {
      allow read, create, update, delete: if isAdmin();

      match /recipients/{recipientId} {
        allow read, create, update, delete: if isAdmin();
      }
    }
  }
}
